# Copy to .env and adjust. All settings are read by geovision.core.config.Settings.
GEOVISION_DATA_ROOT=./data/runs
# GEOVISION_DATA_ROOT=s3://geovision-client-bucket/runs
GEOVISION_STAC_URL=https://earth-search.aws.element84.com/v1
GEOVISION_PC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
GEOVISION_TYPST_BIN=typst
GEOVISION_QGIS_IMAGE=geovision-qgis:latest
GEOVISION_LOG_LEVEL=INFO
